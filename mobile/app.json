{
  "expo": {
    "name": "Garzoni",
    "slug": "garzoni",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "garzoni",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/garzoni-logo-square-no-bg.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f14"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "app.garzoni.mobile",
      "buildNumber": "9",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow Garzoni to choose a profile photo from your library (shown on this device until you update your avatar in account settings).",
        "NSUserNotificationsUsageDescription": "Garzoni sends notifications to remind you of daily learning goals, streak milestones, and mission completions.",
        "NSCameraUsageDescription": "Garzoni uses the camera to scan receipts and statements for AI-powered spending insights (Pro feature).",
        "NSMicrophoneUsageDescription": "Garzoni uses the microphone for the voice tutor so you can ask finance questions hands-free (Pro feature)."
      },
      "requireFullScreen": true,
      "associatedDomains": [
        "applinks:garzoni.app",
        "applinks:www.garzoni.app"
      ],
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ],
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f14"
      },
      "package": "app.garzoni.mobile",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      [
        "customerio-reactnative",
        {
          "ios": {
            "pushNotification": {
              "useRichPush": false
            }
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "65781f5d-673f-484b-866c-b8dc165a160b"
      }
    },
    "owner": "andreineagoe",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/65781f5d-673f-484b-866c-b8dc165a160b"
    }
  }
}
