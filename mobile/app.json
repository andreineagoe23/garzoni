{
  "expo": {
    "name": "Garzoni",
    "slug": "garzoni",
    "version": "1.1.6",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "garzoni",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/garzoni-logo-square-no-bg.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f14"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "app.garzoni.mobile",
      "buildNumber": "6",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow Garzoni to choose a profile photo from your library (shown on this device until you update your avatar in account settings).",
        "NSUserNotificationsUsageDescription": "Garzoni sends notifications to remind you of daily learning goals, streak milestones, and mission completions.",
        "NSCameraUsageDescription": "Garzoni uses the camera to scan receipts and statements for AI-powered spending insights (Pro feature).",
        "NSMicrophoneUsageDescription": "Garzoni uses the microphone for the voice tutor so you can ask finance questions hands-free (Pro feature).",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "associatedDomains": [
        "applinks:garzoni.app",
        "applinks:www.garzoni.app"
      ],
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ],
        "aps-environment": "production"
      }
    },
    "androidNavigationBar": {
      "enforceContrast": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f14"
      },
      "package": "app.garzoni.mobile",
      "versionCode": 12,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "NOTIFICATIONS",
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "garzoni.app"
            },
            {
              "scheme": "https",
              "host": "www.garzoni.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "65781f5d-673f-484b-866c-b8dc165a160b"
      }
    },
    "owner": "andreineagoe",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/65781f5d-673f-484b-866c-b8dc165a160b"
    }
  }
}
