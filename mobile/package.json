{
  "name": "@garzoni/mobile",
  "version": "1.2.0",
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "@types/react",
        "jest-expo"
      ]
    }
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "bash scripts/dev-start.sh",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:mac": "bash scripts/run-ios-mac.sh",
    "ios:prebuild-clean": "expo prebuild --clean -p ios",
    "ios:rebuild-purchases": "expo prebuild --clean -p ios && expo run:ios",
    "android:prebuild-clean": "expo prebuild --clean -p android",
    "web": "expo start --web",
    "eas:init": "eas init",
    "build:ios:dev": "eas build --platform ios --profile development",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:prod": "eas build --platform ios --profile production",
    "build:android:dev": "eas build --platform android --profile development",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:prod": "eas build --platform android --profile production",
    "submit:ios:prod": "eas submit --platform ios --profile production",
    "submit:android:preview": "eas submit --platform android --profile preview",
    "submit:android:prod": "eas submit --platform android --profile production",
    "test": "jest --config jest.config.js"
  },
  "dependencies": {
    "@amplitude/analytics-react-native": "^1.5.57",
    "@babel/runtime": "^7.20.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@garzoni/core": "workspace:^",
    "@garzoni/tokens": "workspace:^",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.14",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "^8.15.0",
    "@tanstack/query-async-storage-persister": "5.96.1",
    "@tanstack/react-query": "^5.59.15",
    "@tanstack/react-query-persist-client": "5.96.1",
    "axios": "^1.18.1",
    "customerio-expo-plugin": "3.7.2",
    "customerio-reactnative": "6.6.3",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "expo-video": "~3.0.16",
    "i18next": "^23.16.0",
    "lottie-react-native": "~7.3.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^14.1.3",
    "react-native": "0.81.5",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^9.15.2",
    "react-native-purchases-ui": "^9.15.2",
    "react-native-reanimated": "~4.1.7",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.2.1",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-native-youtube-iframe": "^2.4.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@sentry/cli": "^3.5.0",
    "@types/jest": "29.5.14",
    "@types/react": "~18.2.79",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "^54.0.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "jest": "29.7.0",
    "jest-expo": "54.0.17",
    "typescript": "~5.9.2"
  }
}
